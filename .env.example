# ==========================================
# Melbourne Property AI Advisor Config (.env)
# ==========================================

# 1. OPTION A: 100% FREE LOCAL (Ollama) - NO API KEY NEEDED
# Run `ollama run llama3.2` in terminal first
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# 2. OPTION B: OpenAI API (Paid or Free Trial Credits)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# 3. OPTION C: Groq API (100% Free Tier - ultra fast)
# Get free key at https://console.groq.com/keys
# OPENAI_API_KEY=your_groq_api_key_here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# 4. OPTION D: Hugging Face (Optional - silences rate limit warning)
# Get free token at https://huggingface.co/settings/tokens
# HF_TOKEN=your_hf_token_here
# HUGGINGFACEHUB_API_TOKEN=your_hf_token_here
