---
import Layout from '../layouts/Layout.astro';
---

<Layout 
	title="Best Weight Loss Program Chennai | Contact COZ Fitness"
	description="Ready to start the best weight loss program in Chennai? Contact COZ Fitness Ambattur today for a free consultation."
	keywords="weight loss program chennai, gym contact number Chennai, COZ fitness location"
>
	<section class="page-header">
		<div class="container animate text-center">
			<span class="tag">Connect With Us</span>
			<h1 class="text-white mt-4">Start Your <span class="text-red">Transformation</span></h1>
			<p class="text-white opacity-8 max-width-800 mx-auto">Get in touch with Chennai's elite coaching staff and take the first step towards a better you.</p>
		</div>
	</section>

	<section class="section-padding">
		<div class="container contact-grid">
			<div class="contact-details">
				<span class="tag">Inquiry</span>
				<h2 class="mt-4">Have a Question?</h2>
				<p class="intro-desc mb-5">Whether you need details on pricing, personal training, or our 90-day transformation programs, our team is ready to assist you in person or online.</p>
				
				<div class="info-group mt-5">
					<div class="info-card">
						<div class="i-icon-box">📍</div>
						<div class="i-txt">
							<h4>Visit Our Facility</h4>
							<p>32, Ayyappakkam Main Rd, T.G, Anna Nagar, Ambattur, Chennai - 600053</p>
						</div>
					</div>
					<div class="info-card">
						<div class="i-icon-box">📞</div>
						<div class="i-txt">
							<h4>Call Now</h4>
							<p>95142 86000 / 95142 87000</p>
						</div>
					</div>
					<div class="info-card">
						<div class="i-icon-box">✉️</div>
						<div class="i-txt">
							<h4>Email Us</h4>
							<p>info@cozfitness.com</p>
						</div>
					</div>
				</div>

				<div class="mt-5">
					<a href="https://wa.me/919514286000" class="btn btn-outline" style="width: 100%;">Chat on WhatsApp</a>
				</div>
			</div>

			<div class="contact-form-card shadow-lg">
				<h3>Send a Message</h3>
				<form class="c-form">
					<div class="form-row">
						<div class="f-group">
							<label>Full Name</label>
							<input type="text" placeholder="John Doe" required />
						</div>
						<div class="f-group">
							<label>Phone Number</label>
							<input type="tel" placeholder="98400 xxxxx" required />
						</div>
					</div>
					<div class="f-group">
						<label>Service Interest</label>
						<select>
							<option>Weight Loss Program</option>
							<option>Personal Training</option>
							<option>Membership Plans</option>
						</select>
					</div>
					<div class="f-group">
						<label>Message</label>
						<textarea rows="4" placeholder="Tell us about your fitness goals..."></textarea>
					</div>
					<button type="submit" class="btn btn-full">Submit Inquiry</button>
				</form>
			</div>
		</div>
	</section>

    <!-- Map Section -->
    <section class="section-padding bg-light">
        <div class="container">
            <div class="text-center mb-5">
                <span class="tag">Locator</span>
                <h2 class="mt-4">Find Us In Ambattur</h2>
            </div>
            <div class="map-container shadow-lg">
                <!-- Interactive Map UI -->
                <div class="map-overlay">
                    <div class="map-pannel animate">
                        <h3>COZ Fitness Ambattur</h3>
                        <p>32, Ayyappakkam Main Rd, Chennai, Tamil Nadu 600053</p>
                        <a href="https://www.google.com/maps/dir//COZ+FITNESS,+32,+Ayyappakkam+Main+Rd,+T.G,+Anna+Nagar,+Ambattur,+Chennai,+Tamil+Nadu+600053" target="_blank" class="btn btn-sm">Get Directions</a>
                    </div>
                </div>
                <iframe 
                    src="https://maps.google.com/maps?q=COZ%20FITNESS%2C%2032%2C%20Ayyappakkam%20Main%20Rd%2C%20Ambattur%2C%20Chennai%2C%20Tamil%20Nadu%20600053&t=&z=15&ie=UTF8&iwloc=&output=embed" 
                    width="100%" 
                    height="600" 
                    style="border:0;" 
                    allowfullscreen="" 
                    loading="lazy" 
                    referrerpolicy="no-referrer-when-downgrade">
                </iframe>
            </div>
        </div>
    </section>

    <section class="section-padding">
        <div class="container seo-long-form">
            <h2>Start the Best Weight Loss Program in Chennai</h2>
            <p>Ready to shed those extra pounds? Our **weight loss program in Chennai** is designed for those who have struggled with traditional gyms. We combine metabolic conditioning with the **best gym in Ambattur**'s premium environment to ensure you stay motivated and see consistent progress.</p>
            
            <div class="spacer-80"></div>

            <h3>Accessible Fitness in Ambattur & Ayappakkam</h3>
            <p>Located on the bustling Ayyappakkam Main Road, COZ Fitness is accessible to residents across Ambattur, Anna Nagar, and Avadi. We provide ample parking and a welcoming atmosphere for all our members, making it the perfect fitness destination for your morning or evening routine.</p>
        </div>
    </section>

	<section class="section-padding bg-red text-center">
		<div class="container">
			<h2 class="text-white">Join the Community Today</h2>
			<p class="text-white opacity-8 mb-4">Transform your life at the #1 gym in Ambattur.</p>
			<a href="/" class="btn btn-white">Back to Home</a>
		</div>
	</section>
</Layout>

<style>
	.page-header {
		height: 60vh;
		background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.4)), url('https://images.unsplash.com/photo-1596733430284-f74377611319?auto=format&fit=crop&q=80&w=1470') center/cover;
		display: flex;
		align-items: center;
		justify-content: center;
	}

    .page-header h1 { font-size: 4.5rem; text-shadow: 0 4px 20px rgba(0,0,0,0.5); }

    .tag {
		background: var(--accent-color);
		color: var(--primary-color);
		padding: 0.6rem 1.2rem;
		border-radius: 8px;
		font-weight: 800;
		text-transform: uppercase;
		font-size: 0.8rem;
		letter-spacing: 1.5px;
	}

    .intro-desc { font-size: 1.25rem; }

	.contact-grid {
		display: grid;
		grid-template-columns: 1fr 1.1fr;
		gap: 8rem;
		align-items: flex-start;
	}

	.info-card {
		display: flex;
		gap: 2.5rem;
		margin-bottom: 3.5rem;
		padding: 3rem;
		background: var(--bg-color);
		border-radius: 30px;
		border: 1px solid var(--border-color);
        box-shadow: var(--shadow);
        transition: var(--transition);
	}

    .info-card:hover { transform: translateY(-5px); border-color: var(--primary-color); }

	.i-icon-box { font-size: 2.5rem; width: 80px; height: 80px; background: var(--accent-color); display: flex; align-items: center; justify-content: center; border-radius: 20px; }
	.i-txt h4 { margin-bottom: 0.5rem; font-size: 1.4rem; }
	.i-txt p { font-size: 1.1rem; margin-bottom: 0; }

	.contact-form-card {
		background: var(--bg-color);
		padding: 6rem 5rem;
		border-radius: 40px;
		border: 1px solid var(--border-color);
        box-shadow: var(--shadow-lg);
	}

	.contact-form-card h3 { text-align: center; margin-bottom: 4rem; font-size: 2rem; }

	.form-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
	}

	.f-group { margin-bottom: 2rem; }
	.f-group label { display: block; margin-bottom: 0.75rem; font-weight: 800; font-size: 1rem; color: var(--text-color); }
	.f-group input, .f-group select, .f-group textarea {
		width: 100%;
		padding: 1.25rem;
		border-radius: 15px;
		border: 2px solid var(--border-color);
		font-family: inherit;
		transition: var(--transition);
		background: var(--secondary-bg);
        font-size: 1.1rem;
        color: var(--text-color);
	}

	.f-group input:focus, .f-group select:focus, .f-group textarea:focus {
		outline: none;
		border-color: var(--primary-color);
		background: var(--bg-color);
	}

	.btn-full { width: 100%; border-radius: 100px; }

    /* Map Styles */
    .map-container {
        position: relative;
        border-radius: 40px;
        overflow: hidden;
        border: 4px solid var(--bg-color);
    }

    .map-overlay {
        position: absolute;
        bottom: 40px;
        left: 40px;
        z-index: 10;
        pointer-events: none;
    }

    .map-pannel {
        background: var(--bg-color);
        padding: 3rem;
        border-radius: 30px;
        box-shadow: var(--shadow-lg);
        max-width: 350px;
        pointer-events: auto;
        border: 1px solid var(--border-color);
    }

    .map-pannel h3 { font-size: 1.5rem; margin-bottom: 1rem; color: var(--primary-color); }
    .map-pannel p { font-size: 1rem; margin-bottom: 2rem; }

    .seo-long-form {
        max-width: 950px;
        margin: 0 auto;
    }

    .seo-long-form p { font-size: 1.25rem; line-height: 2; margin-bottom: 2rem; }
    .spacer-80 { height: 80px; }
    .mt-4 { margin-top: 2rem; }
    .mt-5 { margin-top: 5rem; }
    .opacity-8 { opacity: 0.8; }

	@media (max-width: 992px) {
		.page-header { height: auto; padding: 12rem 0 8rem; text-align: center; }
        .page-header h1 { font-size: 3.5rem; }
		.contact-grid { grid-template-columns: 1fr; gap: 4rem; text-align: center; }
		.contact-form-card { padding: 4rem 2rem; }
		.form-row { grid-template-columns: 1fr; }
        .info-card { flex-direction: column; text-align: center; align-items: center; padding: 3rem 1.5rem; }
        .map-overlay { position: static; padding: 2rem; width: 100%; pointer-events: auto; }
        .map-pannel { max-width: 100%; margin: 0 auto; text-align: center; }
	}

    @media (max-width: 576px) {
        .page-header h1 { font-size: 2.75rem; }
        .contact-form-card { padding: 3rem 1.5rem; }
        .i-icon-box { width: 70px; height: 70px; font-size: 2rem; }
    }
</style>
